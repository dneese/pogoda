# Telegram
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
WEBHOOK_URL=https://your-app.onrender.com
USE_POLLING=true

# Supabase PostgreSQL (pooler Session mode, порт 5432; пароль percent-енкодований)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
PG_POOL_MAX=10

# Supabase (для майбутнього; pg-бот не використовує)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Погода
TIMEZONE=Europe/Kyiv
# Скільки днів прогнозу брати з Open-Meteo (hourly; minutely_15 — завжди 24 год)
FORECAST_DAYS=3
# Вікно «іміджент» — дощ найближчими годинами
SOON_WINDOW_HOURS=3
# Горизонт аутлуку («найближчі дні»)
OUTLOOK_MAX_HOURS=72
# Поріг виявлення дощу (мм/год) — для побудови подій
RAIN_THRESHOLD_MM=0.3
# «Значний дощ»: ігноруємо дрібний (<MIN_RAIN_MM_H) або короткий
# (<MIN_RAIN_DURATION_HOURS) — крім сильного >=HEAVY_RAIN_MM_H
MIN_RAIN_MM_H=0.5
MIN_RAIN_DURATION_HOURS=2
HEAVY_RAIN_MM_H=3
# Свіжість прогнозу біля події (хв) — для точного часу старту
IMMINENT_TTL_MIN=10
# «Раптовий дощ»: нове 🚨-повідомлення, якщо початок у межах N хвилин
SUDDEN_MINUTES=60
# Сітка кластеризації підписників (~12 км)
CLUSTER_GRID_DEG=0.11
# TTL кешу прогнозу для далеких подій
FORECAST_CACHE_TTL_MIN=60
# Паралельність надсилання/редагування повідомлень
SEND_CONCURRENCY=10