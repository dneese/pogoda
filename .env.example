# Telegram
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
WEBHOOK_URL=https://your-app.pandastack.ai
USE_POLLING=true
# Секрет для перевірки запитів вебхуку (X-Telegram-Bot-Api-Secret-Token).
# Якщо не заданий і є WEBHOOK_URL — генерується випадковий при старті.
TELEGRAM_WEBHOOK_SECRET=

# Supabase PostgreSQL (pooler, порт 5432; пароль percent-енкоджений)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
PG_POOL_MAX=10

# Логування: debug | info | warn | error
LOG_LEVEL=info

# Часовий пояс для форматування часу в повідомленнях
TIMEZONE=Europe/Kyiv
# Горизонт прогнозу у днях (Open-Meteo hourly; minutely_15 — тільки перші 24 години)
FORECAST_DAYS=3
# За скільки годин до події попереджати (іміджент-вікно)
SOON_WINDOW_HOURS=3
# Дальній аутлук (годин)
OUTLOOK_MAX_HOURS=72
# Поріг інтенсивності дощу (мм/год), нижче — не «справжній» дощ
RAIN_THRESHOLD_MM=0.3
# «Значний дощ»: інтенсивність >= MIN_RAIN_MM_H І тривалість >= MIN_RAIN_DURATION_HOURS,
# або коротка, але сильна злива >= HEAVY_RAIN_MM_H
MIN_RAIN_MM_H=0.5
MIN_RAIN_DURATION_HOURS=2
HEAVY_RAIN_MM_H=3
# Пориви вітру (м/с), за яких подія класифікується як urgent (ураган)
URGENT_WIND_MS=25
# Кеш прогнозу біля події освіжається частіше (хв) — точність часу старту
IMMINENT_TTL_MIN=10
# «Раптове» pop-up повідомлення, якщо дощ починається менш ніж через N хвилин
SUDDEN_MINUTES=60
# Сітка кластеризації підписників (°, ~12 км при 0.11)
CLUSTER_GRID_DEG=0.11
# TTL кешу прогнозу в БД (хв)
FORECAST_CACHE_TTL_MIN=60
# Паралельних воркерів розсилки
SEND_CONCURRENCY=10
# Таймаут та ретраї Open-Meteo на один запит
OPEN_METEO_TIMEOUT_MS=15000
OPEN_METEO_RETRIES=2
# Антифlood: максимум повідомлень з одного чату за хвилину
RATE_LIMIT_MSGS=20
